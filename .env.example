# ---------- X（推特）数据源，二选一 ----------
# 方案 A: twitterapi.io（按量付费，约 $0.15 / 1000 条推文）
X_PROVIDER=twitterapi_io
X_API_KEY=

# 方案 B: socialdata.tools
# X_PROVIDER=socialdata
# X_API_KEY=

# 方案 C: 官方 X API v2（Basic $200/月）
# X_PROVIDER=official_v2
# X_BEARER_TOKEN=

# ---------- 链上数据（都可留空，留空则该采集器自动跳过） ----------
# Etherscan V2 统一 key，一个 key 覆盖 ETH / Base / BSC / Arbitrum，免费额度 100k/天
ETHERSCAN_API_KEY=
# Solana RPC，建议用 Helius 免费档；留空则用公共 RPC（限流严重）
SOLANA_RPC_URL=

# ---------- 告警 ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
